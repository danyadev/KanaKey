  },
  "dependencies": {
    "@vitejs/plugin-vue": "6.0.7",
    "pinia": "^3.0.4",
    "vite": "8.0.16",
    "vue": "3.5.35"
  },
  "devDependencies": {
    "@types/node": "25.9.2",
    "@vitejs/plugin-vue-jsx": "5.1.5",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "0.9.1",
    "happy-dom": "^20.10.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "vue-tsc": "3.3.4"
  }
}
