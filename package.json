{
  "name": "kanakey",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.1 || >=24",
    "yarn": "^1.22.22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
